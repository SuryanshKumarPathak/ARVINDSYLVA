# ============================================================
# Arvind Sylva – Server Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# Application
NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/arvind-sylva

# JWT Secrets (use strong random strings, minimum 64 characters)
JWT_ACCESS_SECRET=your_jwt_access_secret_minimum_64_characters_long_random_string_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_minimum_64_characters_long_different_string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Cookie Secret
COOKIE_SECRET=your_cookie_secret_minimum_32_characters_random_string

# CORS
CLIENT_URL=http://localhost:5173

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
EMAIL_FROM_NAME=Arvind Sylva
EMAIL_FROM_ADDRESS=noreply@arvindsylva.com
ADMIN_NOTIFICATION_EMAIL=sales@arvindsylva.com

# Initial Admin Seed (used only by seed:admin script)
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@arvindsylva.com
SEED_ADMIN_PASSWORD=Change@Me#2024

# Contact Configuration
CONTACT_PHONE=+919999999999
CONTACT_WHATSAPP=919999999999

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_LEADS=5
RATE_LIMIT_MAX_LOGIN=10

# Optional: Redis (for production rate limiting)
# REDIS_URL=redis://localhost:6379

# Optional: Cloudinary (for media management)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
